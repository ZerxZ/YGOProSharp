<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>YGOProSharp.WindBot</AssemblyName>
    <RootNamespace>WindBot</RootNamespace>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YGOProSharp.Abstractions\YGOProSharp.Abstractions.csproj" />
    <ProjectReference Include="..\YGOProSharp.Core\YGOProSharp.Core.csproj" />
    <ProjectReference Include="..\YGOProSharp.Protocol\YGOProSharp.Protocol.csproj" />
    <ProjectReference Include="..\YGOProSharp.Generators\YGOProSharp.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Decks\**\*;Dialogs\**\*;Data\**\*;Deck\**\*;*.conf;*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
