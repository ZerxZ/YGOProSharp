<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\YGOProSharp.Generators\YGOProSharp.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\YGOProSharp.Abstractions\YGOProSharp.Abstractions.csproj" />
        <ProjectReference Include="..\YGOProSharp.AgentBridge\YGOProSharp.AgentBridge.csproj" />
        <ProjectReference Include="..\YGOProSharp.Core\YGOProSharp.Core.csproj" />
        <ProjectReference Include="..\YGOProSharp.Mcp\YGOProSharp.Mcp.csproj" />
        <ProjectReference Include="..\YGOProSharp.Persistence\YGOProSharp.Persistence.csproj" />
        <ProjectReference Include="..\YGOProSharp.Protocol\YGOProSharp.Protocol.csproj" />
        <ProjectReference Include="..\YGOProSharp.Server\YGOProSharp.Server.csproj" />
        <ProjectReference Include="..\YGOProSharp.WindBot\YGOProSharp.WindBot.csproj" />
    </ItemGroup>

    <ItemGroup Condition="Exists('wwwroot')">
        <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
