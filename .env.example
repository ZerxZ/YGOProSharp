# ==============================================================================
# YGOProSharp 容器化运行环境变量模板
# 使用方式：复制本文件为 .env 后按需调整（本服务零内置大模型 SDK，无需任何 LLM API Key）
#   1. 单机轻量模式（默认 SQLite WAL + 内存缓存）：docker compose up -d
#   2. 生产双擎模式（PostgreSQL 17 + Redis 7）：  docker compose --profile prod up -d
# ==============================================================================

# ---------- 1. 宿主机端口映射 ----------
# 游戏联机协议端口（MDPro3 / YGOPro 客户端连接）
YGOPRO_HOST_GAME_PORT=7911

# 统一 Web 端口（默认打开 / 为前台玩家大厅，访问 /admin 进入管理员控制台，/mcp 为外部 AI MCP 入口）
YGOPRO_HOST_WEB_PORT=7912

# 展示给前台玩家面板的公网联机域名或 IP（留空自动回退当前访问域名）
YGOPRO_PUBLIC_GAME_HOST=

# 若部署在 HTTPS 反向代理后，设为 true 启用 Secure Cookie
YGOPRO_REQUIRE_HTTPS_COOKIE=false

# ---------- 2. 游戏服基础行为 ----------
YGOPRO_MULTI_ROOM=true
YGOPRO_LOG_LEVEL=Information

# ---------- 3. 初始管理员账号引导 ----------
# 自定义初始管理员用户名（留空默认 admin）
YGOPRO_BOOTSTRAP_ADMIN_USER=admin
# 自定义初始管理员密码（至少 6 位；留空则在首次启动日志中生成一次性随机密码并要求首次登录改密）
YGOPRO_BOOTSTRAP_ADMIN_PASSWORD=

# ---------- 4. 运营数据库与多级缓存配置 ----------
# 单机模式保持 Sqlite 即可（默认落盘 /app/data/db/ygoprosharp.db，自动开启 WAL）
# 启用 `--profile prod` 时，改为 Postgres 并取消下方连接串与 Redis 注释：
YGOPRO_DB_PROVIDER=Sqlite
YGOPRO_DB_CONNECTION_STRING=Data Source=/app/data/db/ygoprosharp.db
YGOPRO_REDIS_URL=

# [生产 Profile 示例：启用 docker compose --profile prod up -d 时使用]
# YGOPRO_DB_PROVIDER=Postgres
# YGOPRO_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=ygoprosharp;Username=ygopro;Password=ChangeMe_PgStrongPass
# YGOPRO_REDIS_URL=redis:6379

# ---------- 5. PostgreSQL 容器初始化参数（仅 --profile prod 生效，内网隔离不暴露公网） ----------
POSTGRES_DB=ygoprosharp
POSTGRES_USER=ygopro
POSTGRES_PASSWORD=ChangeMe_PgStrongPass
